{
  "app-id": "org.gtk.DocumentSearcher",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "document-searcher",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home:ro",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--env=TESSDATA_PREFIX=/app/share/tessdata/",
    "--env=DOCUMENT_SEARCHER_OCR_LANG=eng"
  ],
  "cleanup": ["/include", "/lib/pkgconfig", "/share/man", "*.a", "*.la"],
  "modules": [
    {
      "name": "leptonica",
      "buildsystem": "autotools",
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/DanBloomberg/leptonica/releases/download/1.83.1/leptonica-1.83.1.tar.gz",
          "sha256": "c9ab86bc8ebbb9e6a0d0d62c9c7f1e56b4618a8ea8d052bebc86d4eebccdd684"
        }
      ]
    },
    {
      "name": "tesseract",
      "buildsystem": "autotools",
      "config-opts": ["--disable-graphics"],
      "build-options": {
        "env": {"LIBLEPT_HEADERSDIR": "/app/include/leptonica"}
      },
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/tesseract-ocr/tesseract/archive/refs/tags/5.3.3.tar.gz",
          "sha256": "dc7fce723a1a36412eec80f55cf552a8a1ffba511c75c88b64e525a74e190399"
        },
        {"type": "shell", "commands": ["./autogen.sh"]}
      ]
    },
    {
      "name": "tessdata",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/share/tessdata",
        "install -Dm644 eng.traineddata /app/share/tessdata/eng.traineddata"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/main/eng.traineddata",
          "sha256": "7d4322bd2a7749724879683fc3912cb542f19906f83b49e08d0b2d21fdef153f"
        }
      ]
    },
    {
      "name": "document-searcher",
      "buildsystem": "simple",
      "build-commands": [
        ". /usr/lib/sdk/rust-stable/enable",
        "cargo build --release --offline --target-dir=target --no-default-features --features desktop",
        "install -Dm755 target/release/document-searcher /app/bin/document-searcher",
        "install -Dm644 data/org.gtk.DocumentSearcher.desktop /app/share/applications/org.gtk.DocumentSearcher.desktop",
        "install -Dm644 data/org.gtk.DocumentSearcher.metainfo.xml /app/share/metainfo/org.gtk.DocumentSearcher.metainfo.xml",
        "install -Dm644 data/org.gtk.DocumentSearcher.gschema.xml /app/share/glib-2.0/schemas/org.gtk.DocumentSearcher.gschema.xml",
        "glib-compile-schemas /app/share/glib-2.0/schemas"
      ],
      "sources": [
        {"type": "dir", "path": "../"},
        {"type": "file", "path": "flatpak/generated-sources.json"}
      ],
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/document-searcher/cargo",
          "CARGO_NET_OFFLINE": "true",
          "RUSTFLAGS": "-C link-arg=-Wl,-rpath,/app/lib"
        }
      }
    }
  ]
}
