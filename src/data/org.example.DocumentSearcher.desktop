[Desktop Entry]
Type=Application
Name=Document Searcher
GenericName=Document Search
Comment=Search through documents in a folder
Exec=document-searcher
Icon=org.gtk.DocumentSearcher
Terminal=false
Categories=Utility;TextTools;Office;
StartupNotify=true
MimeType=text/plain;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/pdf;text/markdown;image/png;image/jpeg;image/tiff;image/bmp;
Keywords=search;document;file;text;ocr;
