<templates>
  <template class="SidebarRow" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">12</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">8</property>
    <property name="margin-bottom">8</property>

    <child>
      <object class="GtkImage" id="file_icon">
        <property name="icon-name">text-x-generic-symbolic</property>
        <property name="pixel-size">24</property>
        <property name="valign">center</property>
      </object>
    </child>

    <child>
      <object class="GtkLabel" id="file_label">
        <property name="xalign">0</property>
        <property name="ellipsize">end</property>
        <property name="max-width-chars">50</property>
      </object>
      <packing>
        <property name="expand">True</property>
      </packing>
    </child>
  </template>

  <template class="ResultRow" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <property name="margin-top">12</property>
    <property name="margin-bottom">12</property>

    <child>
      <object class="GtkBox" id="header_box">
        <property name="orientation">horizontal</property>
        <property name="spacing">8</property>

        <child>
          <object class="GtkLabel" id="result_number">
            <property name="xalign">0</property>
            <property name="halign">start</property>
            <property name="valign">start</property>
            <property name="selectable">True</property>
            <style>
              <class name="heading"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkLinkButton" id="file_link">
            <property name="halign">start</property>
            <property name="valign">start</property>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="GtkBox" id="contexts_box">
        <property name="orientation">vertical</property>
        <property name="spacing">4</property>
        <property name="margin-start">40</property>
      </object>
    </child>
  </template>
</templates>

<interface>
  <requires lib="gtk" version="4.10"/>
  <requires lib="adw" version="1.4"/>

  <object class="AdwApplicationWindow" id="main_window">
    <property name="title">Document Searcher</property>
    <property name="default-width">1200</property>
    <property name="default-height">800</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="GtkPaned" id="main_paned">
            <property name="position">600</property>
            <property name="wide">True</property>
            <property name="shrink-start-side">False</property>
            <property name="shrink-end-side">False</property>
            <property name="start-child">
              <object class="AdwNavigationPage" id="sidebar_page">
                <property name="title">Files</property>
                <property name="child">
                  <object class="GtkBox" id="sidebar_box">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>

                    <child>
                      <object class="AdwToolbarView">
                        <property name="top-bars">
                          <object class="AdwHeaderBar" id="sidebar_header">
                            <property name="title-widget">
                              <object class="GtkBox" id="sidebar_title_box">
                                <property name="orientation">vertical</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkLabel" id="folder_label">
                                    <property name="xalign">0</property>
                                    <property name="wrap">True</property>
                                    <property name="ellipsize">end</property>
                                    <property name="max-width-chars">50</property>
                                    <property name="label">Folder: /home/documents</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="file_count_label">
                                    <property name="xalign">0</property>
                                    <property name="label">0 files found</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="content">
                          <object class="GtkScrolledWindow" id="files_scrolled">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">True</property>
                            <property name="child">
                              <object class="GtkListView" id="files_list">
                                <property name="factory">
                                  <object class="GtkSignalListItemFactory">
                                    <signal name="setup" handler="on_file_row_setup" object="sidebar_page"/>
                                    <signal name="bind" handler="on_file_row_bind" object="sidebar_page"/>
                                  </object>
                                </property>
                                <property name="model">
                                  <object class="GtkStringList" id="files_string_list"/>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkBox" id="sidebar_actions">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">6</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkButton" id="change_folder_btn">
                            <property name="label">Change Folder</property>
                            <property name="hexpand">True</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="end-child">
              <object class="GtkBox" id="right_panel">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>

                <child>
                  <object class="AdwNavigationPage" id="search_page">
                    <property name="title">Search</property>
                    <property name="child">
                      <object class="GtkBox" id="search_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>

                        <child>
                          <object class="GtkLabel" id="search_instruction">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="label">Write what you want to find! The search will be performed through all the files found in a folder.</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="AdwEntryRow" id="search_entry">
                            <property name="title">Search input</property>
                            <property name="placeholder-text">Enter the search string...</property>
                            <property name="show-apply-button">False</property>
                            <property name="activates-default">False</property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox" id="search_status_box">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="halign">start</property>

                            <child>
                              <object class="GtkSpinner" id="search_spinner">
                                <property name="visible">False</property>
                                <property name="size-request">24</property>
                                <property name="size-request">24</property>
                              </object>
                            </child>

                            <child>
                              <object class="GtkLabel" id="search_status_label">
                                <property name="xalign">0</property>
                                <property name="valign">center</property>
                                <property name="visible">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>

                <child>
                  <object class="AdwNavigationPage" id="results_page">
                    <property name="title">Results</property>
                    <property name="child">
                      <object class="GtkBox" id="results_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">0</property>

                        <child>
                          <object class="AdwToolbarView">
                            <property name="top-bars">
                              <object class="AdwHeaderBar" id="results_header">
                                <property name="title-widget">
                                  <object class="GtkLabel" id="results_title">
                                    <property name="xalign">0</property>
                                    <property name="label">Result</property>
                                    <style>
                                      <class name="heading"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                            <property name="content">
                              <object class="GtkScrolledWindow" id="results_scrolled">
                                <property name="hscrollbar-policy">never</property>
                                <property name="vexpand">True</property>
                                <property name="child">
                                  <object class="GtkListView" id="results_list">
                                    <property name="factory">
                                      <object class="GtkSignalListItemFactory">
                                        <signal name="setup" handler="on_result_row_setup" object="results_page"/>
                                        <signal name="bind" handler="on_result_row_bind" object="results_page"/>
                                      </object>
                                    </property>
                                    <property name="model">
                                      <object class="GtkListStore" id="results_list_store">
                                        <column type="gchararray"/>
                                        <column type="gchararray"/>
                                        <column type="gchararray"/>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox" id="load_more_box">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">12</property>
                            <property name="halign">center</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                            <property name="visible">False</property>
                            <child>
                              <object class="GtkButton" id="load_more_btn">
                                <property name="label">Show more</property>
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>